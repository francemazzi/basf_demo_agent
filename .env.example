# Data di sistema della demo. Vietato usare new Date() nel codice: usare now() da @basf/core
DEMO_FREEZE_DATE=2026-08-09

DATABASE_URL=postgresql://basf:basf@localhost:55432/basf_demo?schema=public

# LLM: openrouter (default) oppure ollama. Le variabili OPENROUTER_* restano valide.
LLM_PROVIDER=openrouter
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_VISION_MODEL=

# Profilo OpenRouter. Nei test di integrazione si usano solo modelli low-cost.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001

# Profilo Ollama locale (richiede `ollama pull llama3.1` e, per la vision, `ollama pull llava`):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_VISION_MODEL=llava

# Trascrizione delle note vocali. Senza chiave il simulatore manda direttamente il testo.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Canale WhatsApp. Senza queste variabili si usa il simulatore in apps/web.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

API_PORT=3001
