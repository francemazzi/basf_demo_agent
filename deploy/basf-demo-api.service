[Unit]
Description=BASF demo API
After=network.target docker.service

[Service]
Type=simple
User=frasma
WorkingDirectory=/home/frasma/basf-demo-agent
EnvironmentFile=/home/frasma/basf-demo-agent/.env
ExecStart=/usr/bin/pnpm --filter @basf/api start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
